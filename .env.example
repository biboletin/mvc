# This is an example of a .env file for a web application.
# It contains configuration settings for the application, database, session, cookies, cache, mail, security, and more.

# Please replace the placeholder values with your actual configuration settings.

# Application Configuration
# This section contains general settings for the application.
# You can adjust these settings based on your environment and requirements.
# Note: Do not use this file in production without modifying the values.

# Content:
# Application Settings
# Logging Configuration
# Error Handling
# Database Configuration
# Session Configuration
# Cookies Configuration
# Cache Configuration
# Mail Configuration
# Notifications Configuration
# Security Configuration
# Encryption and Hashing
# RESTful settings
# WEBSOCKET settings
# 2FA settings
# MONITORING settings

# Application Settings
APP_NAME=MyApp
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Sofia
APP_FALLBACK_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=base64:your_app_key_here
APP_VERSION=1.0.0

# Logging Configuration
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_INCLUDE_CONTEXT=true
LOG_MAX_FILES=30
LOG_PATH=storage/logs
LOG_FORMAT=default
LOG_DATE_FORMAT="Y-m-d H:i:s"
LOG_ROTATE=true
LOG_ROTATION=daily
LOG_ROTATE_SIZE=10485760
LOG_ROTATE_INTERVAL=86400

# Error Handling
ERROR_REPORTING_ENABLED=true
ERROR_REPORTING=E_ALL
ERROR_DISPLAY=true
ERROR_LOG_PATH=/var/log/myapp/error.log
ERROR_LOG_LEVEL=error
ERROR_LOG_FORMAT=default
ERROR_LOG_DATE_FORMAT="Y-m-d H:i:s"
ERROR_REPORT_FROM=example@example.com
ERROR_REPORT_TO_EMAIL=admin@domain.com,report@domain.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_STRICT=true
DB_ENGINE=InnoDB
DB_TIMEZONE=+00:00
DB_CACHE=true
DB_CACHE_TIME=60
DB_CACHE_PATH=storage/cache

# Session Configuration
SESSION_NAME=myapp_session
SESSION_SECURE=1
SESSION_HTTP=1
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SAMESITE=Lax
SESSION_PATH=/
SESSION_DRIVER=file
SESSION_PREFIX=myapp_
SESSION_COOKIE=myapp_cookie
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_EXPIRE=3600
SESSION_COMPRESS=false
SESSION_REGENERATE=false
SESSION_GC_PROBABILITY=1
SESSION_GC_DIVISOR=100
SESSION_GC_MAXLIFETIME=1440
SESSION_CACHE_LIFETIME=60

# Cookies Configuration
COOKIE_NAME=myapp_cookie
COOKIE_DOMAIN=
COOKIE_SECURE=1
COOKIE_HTTPONLY=1
COOKIE_SAMESITE=Lax
COOKIE_PATH=/
COOKIE_EXPIRE=31536000
COOKIE_PREFIX=myapp_
COOKIE_PRIORITY=Low
COOKIE_PARTITIONED=false
COOKIE_ENCRYPT=false
COOKIE_JAR_PATH=/storage/cookies/jar

# Cache Configuration
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_PREFIX=myapp_cache
CACHE_TTL=60
CACHE_PATH=/var/cache/myapp/cache
CACHE_COMPRESSION=false
CACHE_ENCRYPTION=false

# Mail Configuration
MAIL_HOST=
MAIL_PORT=25
MAIL_TLS=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=MyApp
MAIL_CERTIFICATE_PATH=/path/to/certificate.pem
MAIL_CERTIFICATE_KEY_PATH=/path/to/certificate_key.pem
MAIL_CERTIFICATE_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH_MECHANISM=login
MAIL_TIMEOUT=30
MAIL_MAX_RETRIES=3
MAIL_QUEUE=false
MAIL_QUEUE_CONNECTION=default
MAIL_QUEUE_RETRY_AFTER=60
MAIL_QUEUE_TIMEOUT=120

# Notifications Configuration
NOTIFY_DRIVER=mail
NOTIFY_FROM=from_email
NOTIFY_NAME=from_name
NOTIFY_SUBJECT=subject
NOTIFY_TEMPLATE=template
NOTIFY_PATH=template_path
NOTIFY_CACHE_LIFETIME=60
NOTIFY_CACHE_PATH=cache_path

# Security Configuration
SECURITY_KEY=your_security_key_here
SECURITY_CIPHER=AES-256-CBC
SECURITY_HASH_ALGO=sha256
SECURITY_SALT=your_security_salt_here
SECURITY_COST=12
SECURITY_ROUNDS=10
SECURITY_EXPIRE=3600

# Encryption and Hashing
ENCRYPTION_KEY=base64:your_encryption_key_here
ENCRYPTION_CIPHER=AES-256-CBC
ENCRYPTION_SALT=your_encryption_salt_here
ENCRYPTION_COST=12
ENCRYPTION_ROUNDS=10
ENCRYPTION_IV_LENGTH=16
ENCRYPTION_USE_HMAC=true
HASH_ALGO=sha256
HASH_SALT=your_hash_salt_here
HASH_COST=12
HASH_ROUNDS=10

# RESTful settings
REST_API_PREFIX=/api
REST_API_VERSION=v1

# WEBSOCKET settings
WEBSOCKET_ENABLED=false
WEBSOCKET_HOST=
WEBSOCKET_PORT=6001
WEBSOCKET_PATH=/ws
WEBSOCKET_SSL=false
WEBSOCKET_SSL_CERTIFICATE_PATH=/path/to/ssl_certificate.pem
WEBSOCKET_SSL_KEY_PATH=/path/to/ssl_key.pem
WEBSOCKET_SSL_PASSWORD=
WEBSOCKET_SSL_VERIFY_PEER=true
WEBSOCKET_SSL_VERIFY_HOSTNAME=true
WEBSOCKET_SSL_CA_CERTIFICATES_PATH=/path/to/ca_certificates.pem

# 2FA settings
TFA_ENABLED=false
TFA_SECRET_KEY=your_tfa_secret_key_here
TFA_ALGORITHM=SHA1
TFA_DIGITS=6
TFA_PERIOD=30
TFA_PROVIDER=totp
TFA_ISSUER=MyApp
TFA_LIFETIME=3600
TFA_RETRY_LIMIT=5

# MONITORING settings
MONITORING_ENABLED=false
MONITORING_DRIVER=http
MONITORING_SAMPLE_RATE=1
MONITORING_URL=http://localhost:8080/monitor
MONITORING_INTERVAL=60

# Development Tools
DEV_TOOLS_ENABLED=true
DEV_DEBUGBAR=true
DEV_PROFILER=true
DEV_TRACE=true

# Maintenance and Health Check
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Scheduled maintenance ongoing"
SYSTEM_HEALTH_ENABLED=true
SYSTEM_HEALTH_CACHE_PATH=cache/system/
