            "Bibo\\Core\\Pattern\\Creational\\": "src/Core/Pattern/Creational/",
            "Bibo\\Core\\Pattern\\Structural\\": "src/Core/Pattern/Structural",
            "Bibo\\Core\\Plugin\\": "src/Core/Plugin/",
            "Bibo\\Core\\Provider\\": "src/Core/Providers/",
            "Bibo\\Core\\Request\\": "src/Core/Request/",
