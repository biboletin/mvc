{
    "name": "bibo/mvc",
    "description": "Simple MVC framework with many functionalities",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["framework", "php", "mvc", "bibo", "biboletin"],
    "autoload": {
        "psr-4": {
            "Bibo\\Mvc\\": "src/",
            "Bibo\\App\\": "app/",
            "Tests\\": "tests/"
        },
        "files":[
            "src/constants/main.php",
            "src/constants/app.php",
            "src/functions/formatters.php",
            "src/functions/main.php"
        ]
    },
    "authors": [
        {
            "name": "biboletin",
            "email": "shady_fan@abv.bg"
        }
    ],
    "minimum-stability": "dev",
    "require-dev": {
        "symfony/var-dumper": "7.3.x-dev",
        "phpunit/phpunit": "^11",
        "phpcompatibility/php-compatibility": "^10.0@dev"
    },
    "require": {
        "psr/log": "^3.0@dev",
        "psr/http-message": "^2.0@dev",
        "psr/container": "^2.0@dev",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0@dev",
        "psr/simple-cache": "^3.0@dev",
        "psr/clock": "dev-master",
        "psr/http-server-middleware": "^1.0@dev",
        "psr/http-client": "^1.0@dev",
        "symfony/polyfill-iconv": "1.x-dev",
        "ext-zlib": "*",
        "ext-ftp": "*",
        "twig/twig": "4.x-dev",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-bz2": "*",
        "ext-intl": "*",
        "ext-http": "*"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
