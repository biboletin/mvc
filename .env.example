# App
APP_NAME=Site
APP_URL=http://127.0.0.1
APP_ENV=local
APP_DEBUG=true
# levels: warn, info, debug, critical
APP_DEBUG_LEVEL=warn

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=username
DB_PASSWORD=password

# Session
SESSION_NAME=session_name
SESSION_SECURE=1
SESSION_HTTP=1
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SAMESITE=Lax

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_TLS=false
MAIL_USER=username
MAIL_PASS=password

# Notifications

# Security

# FTP
FTP_ADDR=
FTP_USER=
FTP_PASSWORD=

# Backup
BACKUP_PATH=

# Endpoints
WEATHER_ENDPOINT=
WEATHER_API_KEY=

# Cron
CRON_ENABLED=false
CRON_TIME=

# Jobs
JOB_ENABLED=false
JOB_TIME=

# Tasks
TASK_ENABLED=false
TASK_TIME=

# Worker
WORKER_ENABLED=false

# Logs
LOG_PATH=
LOG_ROTATION=1d
LOG_FORMAT=json