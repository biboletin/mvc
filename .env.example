# App
APP_NAME=Site
APP_URL=http://127.0.0.1
APP_ENV=local
APP_DEBUG=true
# levels: emergency, alert, critical, error, warning, notice, info, debug
APP_LOG_LEVEL=warn
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_KEY=base64:32
APP_CIPHER=AES-256-CBC
APP_HASH=sha256
APP_SALT=salt
APP_COST=12
APP_ROUNDS=10
APP_EXPIRE=3600

# Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=300

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=username
DB_PASSWORD=password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=prefix_
DB_STRICT=true
DB_ENGINE=InnoDB
DB_TIMEZONE=+00:00
DB_CACHE=true
DB_CACHE_TIME=60
DB_CACHE_PATH=cache_path

# Session
SESSION_NAME=session_name
SESSION_SECURE=1
SESSION_HTTP=1
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SAMESITE=Lax
SESSION_PATH=/
SESSION_DRIVER=file
SESSION_PREFIX=session_prefix
SESSION_COOKIE=cookie_name
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_COMPRESS=false
SESSION_REGENERATE=false
SESSION_GC_PROBABILITY=1
SESSION_GC_DIVISOR=100
SESSION_GC_MAXLIFETIME=1440
SESSION_CACHE_LIFETIME=60
SESSION_CACHE_PATH=cache_path

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=1
COOKIE_HTTP=1
COOKIE_SAMESITE=Lax
COOKIE_PATH=/
COOKIE_EXPIRE=31536000
COOKIE_PREFIX=cookie_prefix
COOKIE_ENCRYPT=false
COOKIE_COMPRESS=false
COOKIE_CACHE_LIFETIME=60
COOKIE_CACHE_PATH=cache_path
COOKIE_SALT=salt
COOKIE_COST=12
COOKIE_ROUNDS=10

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=cache_prefix
CACHE_LIFETIME=60
CACHE_PATH=cache_path

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_TLS=false
MAIL_USER=username
MAIL_PASS=password

# Notifications
NOTIFY_DRIVER=mail
NOTIFY_FROM=from_email
NOTIFY_NAME=from_name
NOTIFY_SUBJECT=subject
NOTIFY_TEMPLATE=template
NOTIFY_PATH=template_path
NOTIFY_CACHE_LIFETIME=60
NOTIFY_CACHE_PATH=cache_path

# Security
SECURITY_KEY=security_key
SECURITY_ALGO=sha256
SECURITY_SALT=salt
SECURITY_COST=12
SECURITY_ROUNDS=10
SECURITY_EXPIRE=3600
SECURITY_ATTEMPTS=5
SECURITY_LOCKOUT=300
SECURITY_REMEMBER=31536000
SECURITY_FORGET=3600
SECURITY_RESET=3600
SECURITY_VERIFY=3600
SECURITY_CONFIRM=3600
SECURITY_ACTIVATE=3600
SECURITY_RECOVERY=3600
SECURITY_RECOVERY_LIMIT=5
SECURITY_RECOVERY_EXPIRE=3600
SECURITY_RECOVERY_RESET=3600
SECURITY_RECOVERY_CONFIRM=3600
SECURITY_RECOVERY_ACTIVATE=3600
SECURITY_RECOVERY_REMEMBER=31536000
SECURITY_RECOVERY_FORGET=3600
SECURITY_RECOVERY_VERIFY=3600
SECURITY_RECOVERY_LOCKOUT=300
SECURITY_RECOVERY_ATTEMPTS=5
SECURITY_RECOVERY_SALT=salt
SECURITY_RECOVERY_COST=12

# FTP
FTP_ADDR=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_TIMEOUT=90
FTP_PASSIVE=true
FTP_SSL=false
FTP_BASEDIR=
FTP_CACHE_LIFETIME=60
FTP_CACHE_PATH=cache_path
FTP_SALT=salt
FTP_COST=12
FTP_ROUNDS=10
FTP_EXPIRE=3600

# Backup
BACKUP_PATH=
BACKUP_NAME=
BACKUP_TIME=
BACKUP_COMPRESS=true
BACKUP_ENCRYPT=false
BACKUP_SALT=salt
BACKUP_COST=12
BACKUP_ROUNDS=10
BACKUP_EXPIRE=3600
BACKUP_EXPIRES=7
BACKUP_EXTENSION=zip

# Endpoints
WEATHER_ENDPOINT=
WEATHER_API_KEY=

# Cron
CRON_ENABLED=false
CRON_TIME=
CRON_USER=
CRON_PATH=
CRON_COMMAND=
CRON_LOG=

# Jobs
JOB_ENABLED=false
JOB_TIME=
JOB_USER=
JOB_PATH=
JOB_COMMAND=
JOB_LOG=

# Tasks
TASK_ENABLED=false
TASK_TIME=
TASK_USER=
TASK_PATH=
TASK_COMMAND=
TASK_LOG=

# Worker
WORKER_ENABLED=false
WORKER_TIME=
WORKER_USER=
WORKER_PATH=
WORKER_COMMAND=
WORKER_LOG=
WORKER_QUEUE=
WORKER_CONNECTION=
WORKER_TIMEOUT=60
WORKER_SLEEP=5
WORKER_TRIES=3
WORKER_DELAY=0
WORKER_MEMORY=128
WORKER_RETRIES=3

# Logs
LOG_PATH=
LOG_ROTATION=1d
LOG_FORMAT=json
LOG_LEVEL=warn
LOG_MAX_FILES=5
LOG_MAX_SIZE=10M
LOG_SILENT=false
LOG_CHANNEL=channel
LOG_CACHE_LIFETIME=60
LOG_CACHE_PATH=cache_path

# Terminal
TERMINAL_PATH=
TERMINAL_USER=
TERMINAL_COMMAND=
TERMINAL_LOG=
TERMINAL_HISTORY=false

# Queue
QUEUE_DRIVER=database
QUEUE_PREFIX=queue_prefix
QUEUE_LIFETIME=60
QUEUE_PATH=cache_path

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage_path
STORAGE_PREFIX=storage_prefix
STORAGE_LIFETIME=60
STORAGE_CACHE_PATH=cache_path

# i18n
I18N_DRIVER=file
I18N_PATH=i18n_path
I18N_PREFIX=i18n_prefix
I18N_LIFETIME=60
I18N_CACHE_PATH=cache_path
I18N_CACHE_LIFETIME=60
I18N_DEFAULT=en
I18N_FALLBACK=en
I18N_LOCALE=en
I18N_DOMAIN=messages
I18N_FORMAT=po

# Compression
COMPRESS_DRIVER=gzip
COMPRESS_LEVEL=9
COMPRESS_PATH=cache_path
COMPRESS_LIFETIME=60

# Encryption
ENCRYPT_DRIVER=aes
ENCRYPT_KEY=encryption_key
ENCRYPT_ALGO=aes-256-cbc
ENCRYPT_SALT=salt
ENCRYPT_COST=12
ENCRYPT_ROUNDS=10
ENCRYPT_EXPIRE=3600

# Hashing
HASH_DRIVER=bcrypt
HASH_COST=12
HASH_ROUNDS=10
HASH_SALT=salt
HASH_EXPIRE=3600
HASH_ALGO=sha256
HASH_KEY=hash_key

# Validation
VALIDATION_DRIVER=filter
VALIDATION_PATH=validation_path
VALIDATION_PREFIX=validation_prefix
VALIDATION_LIFETIME=60

# JWT
JWT_SECRET=jwt_secret
JWT_ALGO=HS256
JWT_ISSUER=issuer
JWT_AUDIENCE=audience
JWT_EXPIRE=3600
JWT_REFRESH=604800
JWT_LEEWAY=60

# API
API_VERSION=1.0
API_PREFIX=api
API_DOMAIN=api_domain
API_SECURE=true
API_HTTP=true
API_SAMESITE=Lax
API_PATH=/
API_CACHE_LIFETIME=60
API_CACHE_PATH=cache_path

# OAuth
OAUTH_CLIENT_ID=client_id
OAUTH_CLIENT_SECRET=client_secret
OAUTH_REDIRECT_URI=redirect_uri
OAUTH_SCOPE=scope
OAUTH_STATE=state
OAUTH_GRANT_TYPE=authorization_code
OAUTH_RESPONSE_TYPE=code
OAUTH_TOKEN_TYPE=bearer
OAUTH_TOKEN_EXPIRE=3600
OAUTH_REFRESH_EXPIRE=604800
OAUTH_CACHE_LIFETIME=60
OAUTH_CACHE_PATH=cache_path
