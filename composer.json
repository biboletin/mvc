            "Bibo\\Core\\Theme\\": "src/Core/Theme/",
            "Bibo\\Core\\Traits\\": "src/Core/Traits/",
            "Bibo\\Core\\Utilities\\": "src/Core/Utilities/",
            "Bibo\\Core\\View\\": "src/Core/View/",
            "Bibo\\Core\\Worker\\": "src/Core/Worker/",
            "Bibo\\Core\\Wrapper\\": "src/Core/Wrapper/",
            "Tests\\": "tests/unit/"
